{
  "kind": "collectionType",
  "collectionName": "stocks",
  "info": {
    "singularName": "stock",
    "pluralName": "stocks",
    "displayName": "Stock"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "productName": {
      "type": "string"
    },
    "quantity": {
      "type": "decimal"
    },
    "unit": {
      "type": "enumeration",
      "enum": [
        "KG",
        "PACK",
        "LITER"
      ]
    },
    "minQuantity": {
      "type": "decimal",
      "min": 10
    },
    "stockStatus": {
      "type": "enumeration",
      "enum": [
        "IN STOCK",
        "LOW STOCK",
        "OUT OF STOCK"
      ]
    }
  }
}
