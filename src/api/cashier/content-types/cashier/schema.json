{
  "kind": "collectionType",
  "collectionName": "cashiers",
  "info": {
    "singularName": "cashier",
    "pluralName": "cashiers",
    "displayName": "Cashier"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "password": {
      "type": "password",
      "private": true,
      "required": true
    },
    "workingShift": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "MORNING",
        "AFTERNOON",
        "EVENING"
      ]
    },
    "gender": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "MALE",
        "FEMALE"
      ]
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "order": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::order.order",
      "mappedBy": "cashier"
    }
  }
}
