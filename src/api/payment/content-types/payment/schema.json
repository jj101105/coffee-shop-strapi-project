{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "paymentMethod": {
      "type": "enumeration",
      "enum": [
        "CASH",
        "CARD",
        "QRCODE"
      ]
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "APPROVED",
        "PENDING",
        "FAILED"
      ]
    },
    "order": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::order.order"
    },
    "amount": {
      "type": "decimal"
    },
    "paymentedAt": {
      "type": "datetime"
    }
  }
}
